{{!Adapted from the provided bsg-people.hbs starter code}}
<h1>{{title}}</h1>
<table border="1" cellpadding="5" cellspacing="0">
  <thead>
    <tr>
      <th>Character</th>
      <th>Encounter</th>
      <th>Condition Status</th>
      <th>Duration</th>
      <th>Effect Amount</th>
      {{!Our Own Work}}
      <th>Actions</th>
    </tr>
  </thead>
  <tbody>
    {{#each status_effects}}
      <tr>
        <td>{{displayName}}</td>
        <td>{{nameOfLocation}}</td>
        {{!As suggested, add data-field attributes to the editable cells so JS will knows
        which database column each cell belongs to when saving the update
        See script.js citation for more detail}}
        <td class="editable" data-field="conditionStatus">{{conditionStatus}}</td>
        <td class="editable" data-field="duration">{{duration}}</td>
        <td class="editable" data-field="effectAmount">{{effectAmount}}</td>
        <td>
          {{!Update}}
          <input type="hidden" name="idStatusEffect" value="{{idStatusEffect}}">
          <button class="edit_button btn-update">Edit</button>
          <button class="save_button btn-update" style="display:none;" data-update="/status_effects/update" data-idfield="idStatusEffect"
            data-array='["conditionStatus","duration","effectAmount"]'> Save </button>
          <button class="cancel_button" style="display:none;">Cancel</button>
          {{!Delete}}
          <form method="POST" action="/status_effects/delete" style="display:inline;">
            <input type="hidden" name="idStatusEffect" value="{{idStatusEffect}}">
            <button type="submit" class="btn-delete">Delete</button>
          </form>
        </td>
      </tr>
    {{/each}}
  </tbody>
</table>

{{!Our own Work}}
<h2>Add New Status Effect</h2>
<div class="container">
<form method="POST" action="/status_effects/add" class="form-panel">
  Select Turn:
  <select name="idTurns" required>
    <option value="" disabled selected>Select Turn</option>
    {{#each turnsForDropdown}}
      <option value="{{idTurns}}">
        {{displayName}} - {{nameOfLocation}} (Turn ID: {{idTurns}})
      </option>
    {{/each}}
  </select>
  <br><br>
  Condition Status: <input type="text" name="conditionStatus" required><br>
  Duration: <input type="number" name="duration" required><br>
  Effect Amount: <input type="number" name="effectAmount" required><br>
  <button type="submit" class="btn-add">Add Status Effect</button>
</form>
</div>

<script src="/script.js"></script>

