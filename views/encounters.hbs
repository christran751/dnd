{{!Adapted from the provided bsg-people.hbs starter code}}
<h1>{{title}}</h1>
<table border="1" cellpadding="5" cellspacing="0">
  <thead>
    <tr>
      <th>Location Name</th>
      <th>Location</th>
      {{!Our Own Work}}
      <th>Actions</th>
    </tr>
  </thead>
  <tbody>
    {{#each encounters}}
      <tr>
        {{!As suggested, add data-field attributes to the editable cells. Didn't prompt for it though}}
        {{!Source: https://claude.ai/}}
        <td class="editable" data-field="nameOfLocationInput">{{nameOfLocation}}</td>
        <td class="editable" data-field="locationInput">{{location}}</td>
        <td>
          {{!Our Own Work to Update}}
          <input type="hidden" name="idEncountersInput" value="{{idEncounters}}">
          <button class="edit_button btn-update">Edit</button>
          <button class="save_button btn-update" style="display:none;" data-update="/encounters/update"
            data-idfield="idEncountersInput" data-array='["nameOfLocationInput","locationInput"]'>Save </button>
          <button class="cancel_button" style="display:none;">Cancel</button>
          {{!Our Own Work to Delete}}
          <form method="POST" action="/encounters/delete" style="display:inline;" onsubmit="return confirm('Are you sure you want to delete this encounter?')">
            <input type="hidden" name="idEncountersInput" value="{{idEncounters}}">
            <button type="submit" class="btn-delete">Delete</button>
          </form>
        </td>
      </tr>
    {{/each}}
  </tbody>
</table>

{{!Our Own Work}}
<div class="container">
  <form method="POST" action="/encounters/add" class="form-panel">
    <h2>Add New Encounter</h2>
    <input type="text" name="nameOfLocationInput" placeholder="Name of Encounter" required>
    <input type="text" name="locationInput" placeholder="Location" required>
    <button type="submit" class="btn-add">Add Encounter</button>
  </form>
</div>

<script src="/script.js"></script>


