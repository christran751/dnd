<h1>{{title}}</h1>
<table border="1" cellpadding="5" cellspacing="0">
  <thead>
    <tr>
      <th>Name</th>
      <th>Race</th>
      <th>Class</th>
      <th>Role</th>
      <th>Level</th>
      <th>Max HP</th>
      <th>AC</th>
      <th>Initiative Bonus</th>
      {{!Our Own Work}}
      <th>Actions</th>
    </tr>
  </thead>
  <tbody>
    {{#each characters}}
      <tr>
        {{!As suggested, add data-field attributes to the editable cells so JS will knows
        which database column each cell belongs to when saving the update
        See script.js citation # 2 for more detail}}
        {{!Source: https://claude.ai/}}
        <td class="editable" data-field="displayNameInput">{{displayName}}</td>
        <td class="editable" data-field="raceInput">{{race}}</td>
        <td class="editable" data-field="characterClassInput">{{characterClass}}</td>
        <td class="editable" data-field="characterRoleInput">{{characterRole}}</td>
        <td class="editable" data-field="characterLevelInput">{{characterLevel}}</td>
        <td class="editable" data-field="maxHitPointInput">{{maxHitPoint}}</td>
        <td class="editable" data-field="armorClassInput">{{armorClass}}</td>
        <td class="editable" data-field="initiativeBonusInput">{{initiativeBonus}}</td>
        <td>
            <button class="edit_button btn-update">Edit</button>
            <button class="save_button btn-save" style="display:none;" data-update="/characters/update" data-idfield="idCharactersInput"
            data-array='["displayNameInput","raceInput","characterClassInput","characterRoleInput","characterLevelInput","maxHitPointInput","armorClassInput","initiativeBonusInput"]'>
            Save </button>
          <button class="cancel_button btn-cancel" style="display:none;">Cancel</button>
          <form method="POST" action="/characters/delete" style="display:inline;" onsubmit="return confirm('Are you sure you want to delete this character?')">
            <input type="hidden" name="idCharactersInput" value="{{idCharacters}}">
            <button type="submit" class="btn-delete">Delete</button>
          </form>
        </td>
      </tr>
    {{/each}}
  </tbody>
</table>

{{!Our Own Work}}
<h2>Add New Character</h2>
<div class="container">
<form method="POST" action="/characters/add" class="form-panel">
  Name: <input type="text" name="displayNameInput" required><br>
  Race: <input type="text" name="raceInput"><br>
  Class: <input type="text" name="characterClassInput"><br>
  Role:
  <select name="characterRoleInput">
    <option value="">-- Select Role --</option>
    <option value="PC">PC</option>
    <option value="NPC">NPC</option>
  </select><br>
  Level: <input type="number" name="characterLevelInput"><br>
  Max HP: <input type="number" name="maxHitPointInput"><br>
  AC: <input type="number" name="armorClassInput"><br>
  Initiative Bonus: <input type="number" name="initiativeBonusInput"><br>
  <button type="submit" class="btn-add">Add Character</button>
</form>
</div>

<script src="/script.js"></script>




