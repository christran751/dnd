{{!Adapted from the provided bsg-people.hbs starter code}}
<h1>{{title}}</h1>
<table border="1" cellpadding="5" cellspacing="0">
  <thead>
    <tr>
      <th>Character</th>
      <th>Encounter</th>
      <th>Action Taken</th>
      <th>Round Number</th>
      <th>Action Order</th>
      {{!Our Own Work}}
      <th>Actions</th>
    </tr>
  </thead>
  <tbody>
    {{#each turns}}
      <tr>
        <td>{{displayName}}</td>
        <td>{{nameOfLocation}}</td>
        {{!As suggested, add data-field attributes to the editable cells so JS will knows
        which database column each cell belongs to when saving the update
        See script.js citation for more detail}}
        <td class="editable" data-field="actionTaken">{{actionTaken}}</td>
        <td class="editable" data-field="roundNumber">{{roundNumber}}</td>
        <td class="editable" data-field="actionOrderInRound">{{actionOrderInRound}}</td>
        <td>
          {{!Update}}
          <input type="hidden" name="idTurns" value="{{idTurns}}">
          <button class="edit_button btn-update">Edit</button>
          <button class="save_button btn-update" style="display:none;" data-update="/turns/update" data-idfield="idTurns"
            data-array='["actionTaken","roundNumber","actionOrderInRound"]'> Save </button>
          <button class="cancel_button" style="display:none;">Cancel</button>
          {{!Delete}}
          <form method="POST" action="/turns/delete" style="display:inline;" onsubmit="return confirm('Are you sure you want to delete this specific turn?')">
            <input type="hidden" name="idTurns" value="{{idTurns}}">
            <button type="submit" class="btn-delete">Delete</button>
          </form>
        </td>
      </tr>
    {{/each}}
  </tbody>
</table>

{{!Our Own Work}}
<h2>Add New Turn</h2>
<div class="container">
<form method="POST" action="/turns/add" class="form-panel">
  Select Character Encounter:
  <select name="idCharacterEncounter" required>
    <option value="" disabled selected>Select</option>
    {{#each charEncounters}}
      <option value="{{idCharacterEncounter}}">
        {{displayName}} - {{nameOfLocation}} (ID: {{idCharacterEncounter}})
      </option>
    {{/each}}
  </select>
  <br><br>
  Action Taken: <input type="text" name="actionTaken" required><br>
  Round Number: <input type="number" name="roundNumber" required><br>
  Action Order in Round: <input type="number" name="actionOrderInRound" required><br>
  <button type="submit" class="btn-add">Add Turn</button>
</form>
</div>

<script src="/script.js"></script>
