{{!Adapted from the provided bsg-people.hbs starter code}}
<h1>{{title}}</h1>
<table border="1" cellpadding="5" cellspacing="0">
  <thead>
    <tr>
      <th>Character</th>
      <th>Encounter</th>
      <th>HP Change</th>
      <th>Source</th>
      {{!Our Own Work}}
      <th>Actions</th>
    </tr>
  </thead>
  <tbody>
    {{#each health_logs}}
      <tr>
        <td>{{displayName}}</td>
        <td>{{nameOfLocation}}</td>
        {{!As suggested, add data-field attributes to the editable cells so JS will knows
        which database column each cell belongs to when saving the update
        See script.js citation for more detail}}
        <td class="editable" data-field="hitPointChange">{{hitPointChange}}</td>
        <td class="editable" data-field="hitPointChangeSource">{{hitPointChangeSource}}</td>
        <td>
          {{!Update}}
          <input type="hidden" name="idHealthChangeLogs" value="{{idHealthChangeLogs}}">
          <button class="edit_button btn-update">Edit</button>
          <button class="save_button btn-update" style="display:none;" data-update="/health_logs/update"
          data-idfield="idHealthChangeLogs" data-array='["hitPointChange","hitPointChangeSource"]'> Save </button>
          <button class="cancel_button" style="display:none;">Cancel</button>
          {{!Delete}}
          <form method="POST" action="/health_logs/delete" style="display:inline;" onsubmit="return confirm('Are you sure you want to delete this health log entry?')">
            <input type="hidden" name="idHealthChangeLogs" value="{{idHealthChangeLogs}}">
            <button type="submit" class="btn-delete">Delete</button>
          </form>
        </td>
      </tr>
    {{/each}}
  </tbody>
</table>

{{!Our Own Work}}
<h2>Add New Health Log</h2>
<div class="container">
<form method="POST" action="/health_logs/add" class="form-panel">
  Select Turn:
  <select name="idTurns" required>
    <option value="" disabled selected>Select</option>
    {{#each charEncounters}}
      <option value="{{idTurns}}">
        {{displayName}} - {{nameOfLocation}} (Turn ID: {{idTurns}})
      </option>
    {{/each}}
  </select>
  <br><br>
  HP Change:
  <input type="number" name="hitPointChange" required>
  <br><br>
  Source:
  <input type="text" name="hitPointChangeSource" required>
  <br><br>
  <button type="submit" class="btn-add">Add Health Log</button>
</form>
</div>

<script src="/script.js"></script>
